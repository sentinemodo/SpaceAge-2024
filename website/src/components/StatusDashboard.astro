---
import { formatNextTurn, formatStatusLabel } from '../lib/statusSchema';
import { clientFactionUrl } from '../lib/clientUrls';
import { campaignFactionsByPlanet } from '../data/campaignFactions';

const statusData = {
  status: 'not-started',
  turn: 0,
  nextTurnAt: null as string | null,
  factions: campaignFactionsByPlanet.flatMap((group) =>
    group.factions.map((f) => ({
      id: f.id,
      submitted: false,
      name: `${f.name} (${f.id})`,
      planet: group.planet,
    })),
  ),
};
---

<div class="status-dashboard" id="status-dashboard">
  <div class="status-header">
	<div class="status-item">
	  <span class="status-label">Game Status</span>
	  <span id="status-value" class="status-value">{formatStatusLabel(statusData.status)}</span>
	</div>
	<div class="status-item">
	  <span class="status-label">Turn Number</span>
	  <span id="turn-value" class="status-value">{statusData.turn}</span>
	</div>
	<div class="status-item">
	  <span class="status-label">Total Players</span>
	  <span class="status-value">10 seats</span>
	</div>
	<div class="status-item">
	  <span class="status-label">Next Turn</span>
	  <span id="next-turn-value" class="status-value">{formatNextTurn(statusData.nextTurnAt)}</span>
	</div>
  </div>

  <div id="submissions-grid" class="submissions-grid">
	{campaignFactionsByPlanet.map((group) => (
	  <div class="planet-group">
		<h3 class="planet-heading">{group.planet}</h3>
		<div class="planet-factions">
		  {group.factions.map((faction) => (
			<div class="faction-card pending" data-id={faction.id}>
			  <div class="faction-id">
				<a href={clientFactionUrl(faction.id)} class="faction-link">{faction.name} ({faction.id})</a>
			  </div>
			  <div class="faction-status">⏳ Pending</div>
			</div>
		  ))}
		</div>
	  </div>
	))}
  </div>
</div>

<script>
  import { bindStatusDashboard } from '../lib/statusClient';

  const root = document.getElementById('status-dashboard');
  if (root) bindStatusDashboard(root);
</script>

<style>
  .status-dashboard {
	margin-bottom: var(--space-2xl);
  }

  .status-header {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
	gap: var(--space-lg);
	margin-bottom: var(--space-2xl);
  }

  .status-item {
	background-color: var(--color-card-bg);
	color: var(--color-text-dark);
	padding: var(--space-lg);
	border-radius: var(--radius-lg);
	display: flex;
	flex-direction: column;
	gap: var(--space-sm);
  }

  .status-label {
	font-size: var(--font-size-sm);
	font-weight: var(--font-weight-semibold);
	text-transform: uppercase;
	letter-spacing: 0.05em;
	color: #666;
  }

  .status-value {
	font-size: var(--font-size-2xl);
	font-weight: var(--font-weight-bold);
	color: var(--color-accent-teal);
  }

  .submissions-grid {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: var(--space-lg);
  }

  .planet-group {
	background-color: rgba(13, 148, 136, 0.08);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	padding: var(--space-md);
  }

  .planet-heading {
	margin: 0 0 var(--space-md);
	font-size: var(--font-size-lg);
	color: var(--color-accent-teal);
  }

  .planet-factions {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
	gap: var(--space-md);
  }

  .faction-card {
	background-color: var(--color-card-bg);
	color: var(--color-text-dark);
	padding: var(--space-md);
	border-radius: var(--radius-lg);
	text-align: center;
	border: 2px solid transparent;
	transition: border-color var(--transition-fast);
  }

  .faction-card.submitted {
	border-color: #10b981;
  }

  .faction-card.pending {
	border-color: #f59e0b;
	opacity: 0.8;
  }

  .faction-id {
	font-weight: var(--font-weight-bold);
	font-size: var(--font-size-sm);
	margin-bottom: var(--space-sm);
  }

  .faction-link {
	color: inherit;
	text-decoration: none;
  }

  .faction-link:hover,
  .faction-link:focus-visible {
	color: var(--color-accent-teal);
	text-decoration: underline;
  }

  .faction-status {
	font-size: var(--font-size-sm);
	font-weight: var(--font-weight-semibold);
  }

  @media (max-width: 768px) {
	.status-header {
	  grid-template-columns: 1fr;
	}

	.submissions-grid {
	  grid-template-columns: 1fr;
	}
  }
</style>
