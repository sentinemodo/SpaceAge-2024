---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';

const clientUrl = import.meta.env.PUBLIC_CLIENT_URL || 'http://localhost:8787/client/';
---

<Layout title="Game Client" description="SpaceAge hosted visual client">
  <section class="client-content">
	<h1>Game Client</h1>

	<div class="intro-card card">
	  <h2>Hosted Visual Client</h2>
	  <p>
		Open beta uses the SpaceAge visual tool on the game host. Log in with your faction id (2–11)
		and the password from your invitation. Read XML reports, draft orders, and submit through the server.
	  </p>
	  <p><a class="cta-button" href={clientUrl} id="client-launch">Open SpaceAge Client →</a></p>
	</div>

	<section class="features-section">
	  <h2>What You Can Do</h2>
	  <div class="features">
		<div class="feature-item"><h3>Reports</h3><p>Quarterly XML reports from the game host.</p></div>
		<div class="feature-item"><h3>Star map</h3><p>Filter units by system; region drill-down.</p></div>
		<div class="feature-item"><h3>Orders</h3><p>Editor with engine-backed validation warnings.</p></div>
		<div class="feature-item"><h3>Tools</h3><p><a href={withBase('eta')}>Transit ETA</a> and <a href={withBase('battle')}>Battle what-if</a> on this site; engine sim at <code>tools/battle-simulator</code>.</p></div>
	  </div>
	</section>

	<section class="getting-started card">
	  <h2>Getting Started</h2>
	  <ol>
		<li>Open the <a href={clientUrl}>hosted client</a></li>
		<li>Log in with faction id and password</li>
		<li>Review your quarterly report and draft orders</li>
		<li>Submit before the GM runs the turn</li>
	  </ol>
	</section>
  </section>
</Layout>

<style>
  .client-content { max-width: 900px; margin: 0 auto; }
  h1 { color: var(--color-accent-teal); margin-bottom: var(--space-xl); }
  .intro-card { margin-bottom: var(--space-2xl); }
  .cta-button {
	display: inline-block;
	margin-top: 1rem;
	padding: 0.75rem 1.5rem;
	background: var(--color-accent-teal);
	color: #fff;
	text-decoration: none;
	border-radius: var(--radius-md);
	font-weight: 600;
  }
  .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-lg); }
  .feature-item { background: var(--color-card-bg); color: var(--color-text-dark); padding: var(--space-lg); border-radius: var(--radius-lg); }
</style>
