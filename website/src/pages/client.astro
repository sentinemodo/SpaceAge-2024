---
import Layout from '../layouts/Layout.astro';
import { clientBaseUrl } from '../lib/clientUrls';
import { withBase } from '../lib/paths';

const clientUrl = clientBaseUrl();
const logoUrl = withBase('images/spaceage-logo.png');
---

<Layout title="Game Client" description="SpaceAge hosted visual client">
  <section class="client-content">
	<header class="client-header">
	  <h1>Game Client</h1>
	  <img src={logoUrl} alt="SpaceAge" class="client-logo" width="250" height="310" />
	</header>

	<div class="intro-card card">
	  <h2>Hosted Visual Client</h2>
	  <p>
		Open beta uses the SpaceAge visual tool on the game host. Log in with your faction id (2–11)
		and the password from your invitation. Read XML reports, draft orders, and submit through the server.
	  </p>
	  <p><a class="cta-button" href={clientUrl} id="client-launch">Open SpaceAge Client →</a></p>
	</div>

	<section class="client-features">
	  <h2>What You Can Do</h2>
	  <div class="client-features-grid">
		<div class="feature-item card"><h3>Reports</h3><p>Quarterly XML reports from the game host.</p></div>
		<div class="feature-item card"><h3>Star map</h3><p>Filter units by system; region drill-down.</p></div>
		<div class="feature-item card"><h3>Orders</h3><p>Editor with engine-backed validation warnings.</p></div>
		<div class="feature-item card"><h3>Movement</h3><p>Unit MOVE orders and transit ETA — open the ⇄ panel in the client.</p></div>
	  </div>
	</section>

	<section class="getting-started card">
	  <h2>Getting Started</h2>
	  <ol>
		<li>Open the <a href={clientUrl}>hosted client</a></li>
		<li>Log in with faction id and password</li>
		<li>Review your quarterly report and draft orders</li>
		<li>Submit before the GM runs the turn</li>
	  </ol>
	</section>
  </section>
</Layout>

<style>
  .client-content {
	max-width: 900px;
	margin: 0 auto;
	display: flex;
	flex-direction: column;
	gap: var(--space-2xl);
  }

  .client-header {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: var(--space-lg);
  }

  h1 {
	color: var(--color-accent-teal);
	margin: 0;
	font-size: var(--font-size-3xl);
	line-height: 1.2;
  }

  .client-logo {
	height: var(--font-size-3xl);
	width: auto;
	flex-shrink: 0;
  }

  .cta-button {
	display: inline-block;
	margin-top: 1rem;
	padding: 0.75rem 1.5rem;
	background: var(--color-accent-teal);
	color: #fff;
	text-decoration: none;
	border-radius: var(--radius-md);
	font-weight: 600;
  }

  .client-features {
	display: flex;
	flex-direction: column;
	gap: var(--space-lg);
  }

  .client-features-grid {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: var(--space-lg);
	width: 100%;
  }

  .feature-item h3 {
	margin-top: 0;
  }

  .feature-item p:last-child {
	margin-bottom: 0;
  }

  .getting-started {
	margin: 0;
  }

  @media (max-width: 768px) {
	.client-header {
	  flex-direction: column-reverse;
	  align-items: flex-start;
	}

	.client-features-grid {
	  grid-template-columns: 1fr;
	}
  }
</style>
