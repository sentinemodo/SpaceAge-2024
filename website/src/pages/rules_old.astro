---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
import { renderHumanRulesOldHtml } from '../lib/humanRules';

const rulesHtml = renderHumanRulesOldHtml();
---

<Layout title="Player Rules (previous)" description="SpaceAge PBEM rules — archived copy before campaign setting">
  <section class="rules-content">
    <p class="rules-nav">
      <a href={withBase('rules')}>← Current rules</a>
    </p>

    <div class="intro-card card">
      <h1>Player Rules (previous)</h1>
      <p>
        Archived copy from before the <strong>Campaign setting — The Alderson Points</strong> section was added.
        For live play, use the <a href={withBase('rules')}>current rules</a>.
      </p>
    </div>

    <article class="rules-markdown card" set:html={rulesHtml} />
  </section>
</Layout>

<style>
  .rules-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .rules-nav {
    margin: 0 0 var(--space-lg);
  }

  h1 {
    color: var(--color-accent-teal);
    margin-top: 0;
    margin-bottom: var(--space-md);
  }

  .intro-card {
    margin-bottom: var(--space-xl);
  }

  .rules-markdown :global(h1),
  .rules-markdown :global(h2),
  .rules-markdown :global(h3) {
    color: var(--color-accent-teal);
    margin-top: var(--space-xl);
  }

  .rules-markdown :global(h1:first-child) {
    display: none;
  }

  .rules-markdown :global(p),
  .rules-markdown :global(li) {
    line-height: 1.65;
  }

  .rules-markdown :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-md) 0;
    font-size: var(--font-size-sm);
  }

  .rules-markdown :global(th),
  .rules-markdown :global(td) {
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: var(--space-sm);
    text-align: left;
    vertical-align: top;
  }

  .rules-markdown :global(code),
  .rules-markdown :global(pre) {
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
  }

  .rules-markdown :global(pre) {
    overflow-x: auto;
    padding: var(--space-md);
    background: rgba(0, 0, 0, 0.25);
    border-radius: 4px;
  }

  .rules-markdown :global(a) {
    color: var(--color-accent-teal);
  }

  @media (max-width: 768px) {
    .rules-markdown :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
</style>
