---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
import { renderHumanRulesHtml } from '../lib/humanRules';

const rulesHtml = renderHumanRulesHtml();
---

<Layout title="Player Rules" description="SpaceAge PBEM — order syntax and turn rules (open beta 0.8.001)">
  <section class="rules-content">
    <p class="rules-nav">
      <a href={withBase('technologies')}>Basic technologies (L0–L1)</a>
      ·
      <a href={withBase('rules_old')}>Previous rules (before campaign setting)</a>
    </p>

    <div class="intro-card card">
      <h1>Player Rules</h1>
      <p>
        SpaceAge is an <strong>open PBEM</strong> campaign: you receive quarterly reports, write order files,
        and the host advances the galaxy. You play an <strong>Interest</strong> (player factions <strong>2–11</strong>).
        One turn = one in-game quarter = <strong>13 weeks</strong>.
      </p>
    </div>

    <article class="rules-markdown card" set:html={rulesHtml} />
  </section>
</Layout>

<style>
  .rules-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .rules-nav {
    margin: 0 0 var(--space-lg);
  }

  h1 {
    color: var(--color-accent-teal);
    margin-top: 0;
    margin-bottom: var(--space-md);
  }

  .intro-card {
    margin-bottom: var(--space-xl);
  }

  .rules-markdown :global(h1),
  .rules-markdown :global(h2),
  .rules-markdown :global(h3) {
    color: var(--color-accent-teal);
    margin-top: var(--space-xl);
  }

  .rules-markdown :global(h1:first-child) {
    display: none;
  }

  .rules-markdown :global(p),
  .rules-markdown :global(li) {
    line-height: 1.65;
  }

  .rules-markdown :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-md) 0;
    font-size: var(--font-size-sm);
  }

  .rules-markdown :global(th),
  .rules-markdown :global(td) {
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: var(--space-sm);
    text-align: left;
    vertical-align: top;
  }

  .rules-markdown :global(code),
  .rules-markdown :global(pre) {
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
  }

  .rules-markdown :global(pre) {
    overflow-x: auto;
    padding: var(--space-md);
    background: rgba(0, 0, 0, 0.25);
    border-radius: 4px;
  }

  .rules-markdown :global(a) {
    color: var(--color-accent-teal);
  }

  @media (max-width: 768px) {
    .rules-markdown :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
</style>
