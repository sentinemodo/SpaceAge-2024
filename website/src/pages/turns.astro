---
import Layout from '../layouts/Layout.astro';
import { formatNextTurn, formatStatusLabel } from '../lib/statusSchema';
import { withBase } from '../lib/paths';
import { renderTurnsTableHtml } from '../lib/turnsTable';
---

<Layout title="Players & Turns" description="SpaceAge Turn Status - Orders Submission Status">
  <section class="turns-content" id="turns-page">
	<h1>Players & Turns</h1>

	<div class="status-summary card">
	  <h2>Current Turn Status</h2>
	  <div class="summary-grid">
		<div class="summary-item">
		  <span class="summary-label">Game Turn</span>
		  <span id="turns-turn-value" class="summary-value">1</span>
		</div>
		<div class="summary-item">
		  <span class="summary-label">Orders Received</span>
		  <span id="turns-orders-count" class="summary-value">0 / 10</span>
		</div>
		<div class="summary-item">
		  <span class="summary-label">Game Status</span>
		  <span id="turns-status-value" class="summary-value">{formatStatusLabel('not-started')}</span>
		</div>
		<div class="summary-item">
		  <span class="summary-label">Next Turn</span>
		  <span id="turns-next-value" class="summary-value">{formatNextTurn(null)}</span>
		</div>
	  </div>
	</div>

	<section class="submissions-section">
	  <h2>Faction Orders Status</h2>
	  <p>Status for the player factions</p>

	  <div id="turns-factions-table" set:html={renderTurnsTableHtml(null)} />
	</section>

	<section class="turn-info card">
	  <h2>What Happens Each Turn</h2>
	  <ol>
		<li>
		  <strong>Orders Deadline:</strong> Players read the previous turn's report and submit orders
		  within the deadline (typically one week for a quarterly turn).
		</li>
		<li>
		  <strong>Press releases</strong>, <strong>rumors</strong> and <strong>contracts:</strong> The diplomatic maneuvers are played out between - releases happen asynchronously from turns (but may be part of the standard orders as well) and are distributed immediatelly.
		</li>
		<li>
		  <strong>Processing:</strong> The game master collects all orders and runs the engine to process
		  one quarter (13 weeks) of in-game time.
		</li>
		<li>
		  <strong>Reports:</strong> New faction reports are generated and distributed to each player.
		</li>
		<li>
		  <strong>Next Turn:</strong> The cycle repeats for the following quarter.
		</li>
	  </ol>
	</section>

	<section class="rules-section card">
	  <h2>Want to Learn More?</h2>
	  <p>
		New to SpaceAge? Read the <a href={withBase('rules')}>rules overview</a> to understand what goes into
		each turn and how the game works.
	  </p>
	</section>
  </section>
</Layout>

<script>
  import { bindTurnsPage } from '../lib/statusClient';

  const root = document.getElementById('turns-page');
  if (root) bindTurnsPage(root);
</script>

<style>
  .turns-content {
	max-width: 1100px;
	margin: 0 auto;
  }

  h1 {
	color: var(--color-accent-teal);
	margin-bottom: var(--space-xl);
  }

  .status-summary {
	margin-bottom: var(--space-2xl);
  }

  .summary-grid {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
	gap: var(--space-lg);
	margin-top: var(--space-lg);
  }

  .summary-item {
	display: flex;
	flex-direction: column;
	gap: var(--space-sm);
	padding: var(--space-md);
	background-color: rgba(13, 148, 136, 0.1);
	border-radius: var(--radius-md);
  }

  .summary-label {
	font-size: var(--font-size-sm);
	font-weight: var(--font-weight-semibold);
	text-transform: uppercase;
	letter-spacing: 0.05em;
	color: #666;
  }

  .summary-value {
	font-size: var(--font-size-2xl);
	font-weight: var(--font-weight-bold);
	color: var(--color-accent-teal);
  }

  .submissions-section {
	margin-bottom: var(--space-2xl);
  }

  #turns-factions-table {
	margin-top: var(--space-lg);
  }

  #turns-factions-table :global(.factions-table) {
	background-color: var(--color-card-bg);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	overflow: hidden;
  }

  #turns-factions-table :global(.table-planet-row) {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 0;
	background-color: rgba(13, 148, 136, 0.12);
	border-bottom: 1px solid var(--color-border);
  }

  #turns-factions-table :global(.planet-span) {
	padding: var(--space-md);
	font-size: var(--font-size-lg);
	font-weight: var(--font-weight-bold);
	color: var(--color-accent-teal);
	text-align: center;
  }

  #turns-factions-table :global(.planet-span:first-child) {
	border-right: 1px solid var(--color-border);
  }

  #turns-factions-table :global(.table-header) {
	background-color: rgba(0, 0, 0, 0.1);
	font-weight: var(--font-weight-bold);
	border-bottom: 2px solid var(--color-accent-teal);
  }

  #turns-factions-table :global(.table-header),
  #turns-factions-table :global(.table-row) {
	display: grid;
	grid-template-columns: 2fr 1fr 2fr 1fr;
	gap: 0;
	align-items: center;
  }

  #turns-factions-table :global(.table-row) {
	border-bottom: 1px solid #ddd;
  }

  #turns-factions-table :global(.table-row .faction-col:nth-child(1)) {
	border-right: 1px solid rgba(0, 0, 0, 0.06);
  }

  #turns-factions-table :global(.table-row .faction-col:nth-child(3)) {
	border-left: 1px solid var(--color-border);
	border-right: 1px solid rgba(0, 0, 0, 0.06);
  }

  #turns-factions-table :global(.table-row:last-child) {
	border-bottom: none;
  }

  #turns-factions-table :global(.table-cell) {
	padding: var(--space-md);
	color: var(--color-text-dark);
  }

  #turns-factions-table :global(.faction-col) {
	font-weight: var(--font-weight-semibold);
  }

  #turns-factions-table :global(.status-col) {
	text-align: center;
  }

  #turns-factions-table :global(.status-col.pending) {
	color: #b45309;
  }

  #turns-factions-table :global(.status-col.submitted) {
	color: #047857;
  }

  .turn-info {
	margin-bottom: var(--space-2xl);
  }

  .turn-info ol {
	margin-left: var(--space-lg);
	color: var(--color-text-dark);
  }

  .turn-info li {
	margin-bottom: var(--space-md);
	line-height: 1.8;
  }

  .rules-section {
	text-align: center;
  }

  @media (max-width: 768px) {
	.summary-grid {
	  grid-template-columns: 1fr;
	}

	#turns-factions-table :global(.table-planet-row) {
	  grid-template-columns: 1fr;
	}

	#turns-factions-table :global(.planet-span:first-child) {
	  border-right: none;
	  border-bottom: 1px solid var(--color-border);
	}

	#turns-factions-table :global(.table-header),
	#turns-factions-table :global(.table-row) {
	  grid-template-columns: 1fr 1fr;
	}

	#turns-factions-table :global(.table-row .faction-col:nth-child(3)),
	#turns-factions-table :global(.table-row .faction-col:nth-child(4)) {
	  border-top: 1px solid #ddd;
	}

	#turns-factions-table :global(.table-row .faction-col:nth-child(3)) {
	  border-left: none;
	}

	#turns-factions-table :global(.status-col) {
	  text-align: left;
	}
  }
</style>
