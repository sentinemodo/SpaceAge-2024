using System;
using System.Collections.Generic;
using System.Text;

namespace SpaceAge
{
	public class FactionOptions
	{
		private bool textReport = true;
		public bool TextReport
		{
			get { return this.textReport; }
			set { this.textReport = value; }
		}
		
		public bool xmlReport = true;
		public bool XmlReport
		{
			get { return this.xmlReport; }
			set { this.xmlReport = value; }
		}

		private int reportLineLength = ReportLine.LineLength;
		public int ReportLineLength
		{
			get { return this.reportLineLength; }
			set { this.reportLineLength = value; }
		}
	}
}
